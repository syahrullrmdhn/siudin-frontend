<!doctype html>
<html lang="en" class="fullscreen-bg">

<head>
    <title>{{ system_title }}</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    
	<link rel="icon" href="{{ system_logo }}">
    <link rel="stylesheet" href="{{ base_url }}vendor/bootstrap-v4/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ base_url }}vendor/font-awesome-5/css/all.min.css">
    <link rel="stylesheet" href="{{ base_url }}assets/css/roboto.min.css?_dc={{ current_time }}">
    <link rel="stylesheet" href="{{ base_url }}assets/css/tinymce.css?_dc={{ current_time }}">
    <link rel="stylesheet" href="{{ base_url }}assets/css/new.min.css?_dc={{ current_time }}">
</head>

<body>
    <div class="params" style="display: none" data-materi="{{ materi }}" data-tingkat="{{ tingkat }}" data-babon="{{ babon }}"></div>
    <div class="wrapper">
		<div class="header">
            <div class="header-left">
                <div class="logo"><img src="{{ system_logo }}"></div>
                <div class="title">
                    <h2>{{ system_organization }}</h2>
                    <h2>{{ system_office }}</h2>
                    <h6>{{ system_name }}</h6>
                </div>
            </div>
            <div class="header-toggle">
                <a href="javascript:;" id="sidebar-toggle"><span class="fa fa-bars"></span></a>
            </div>
            <div class="header-right">
                <div class="user-text">
                    {% if user_login %}
						<h6>{{ user_login }}</h6>
						<!--<a href="javascript:;" id="btnLogout" class="btn btn-sm btn-secondary logout btnLogout">Logout</a>-->
					{% endif %}
                </div>
                <div class="user-icon">
                    <!--<span class="fa fa-user-graduate"></soan>-->
                    <div class="photo"><img src="{{ base_url }}assets/img/men.png"></div>
                </div>
            </div>
        </div>
        <div class="main exam">
            <div class="sidebar">
                <div class="photobox">
                    {% if system_camera == '1' %}
                    <div class="webcam-wrapper overflow-hidden" style="border-radius: 10px 10px 0 0"><div class="webcam" id="webcam-image"></div></div>
                    {% else %}
                    <div class="photo"><img src="{{ base_url }}assets/img/men.png"></div>
                    <div class="photo-id">Nama Peserta</div>
                    <div class="photo-name">Nomor Peserta</div>
                    {% endif %}
                </div>
                <div class="sidebar-title">
                    Tes
                </div>
                <div class="sidebar-content">
                    <ul class="nomor-soal" id="nomor-soal">

                    </ul>
                </div>
                <div class="sidebar-footer">
                    <button class="btn btn-sm btn-secondary" id="sidebar-close"><span class="fa fa-times"></span></button>
                </div>
            </div>
            <div class="content">
                <div class="bar-top">
					<span class="soal-nomor-text">SOAL NOMOR</span>
					<div class="soal-title" id="page">1</div>
					<div id="page-count" style="display:none"></div>
					<div class="right">
                        <button class="btn btn-light btn-zoom-out">
							<span class="fa fa-search-minus"></span>
						</button>
                        <button class="btn btn-light btn-zoom-in">
							<span class="fa fa-search-plus"></span>
						</button>
						<div class="timer js-ujian">
							<div class="timer-label d-none d-sm-block">Sisa Waktu</div>
							<div class="timer-time" id="timer">00:00:00</div>
						</div>
                        <!--
                        <button class="btn btn-primary btn-webcam" data-toggle="modal" data-target="#webcam">
							<span class="fa fa-camera"></span>
						</button>
                        -->
					</div>
				</div>
				<div class="soal-wrapper" id="content">
					{{content}}
				</div>
				<div class="button-wrapper">
					<button id="soal-back" class="btn btn-sm btn-light sebelum js-ujian">
						<span class="fa fa-arrow-left"></span><span class="btn-text">Sebelumnya</span>
					</button>
					<button id="soal-next" class="btn btn-sm btn-light sesudah js-ujian">
						<span class="btn-text">Selanjutnya</span><span class="fa fa-arrow-right"></span>
					</button>
                    
					<button id="soal-ragu" class="btn btn-sm btn-warning ragu js-ujian">
						<div class="check-ragu"></div>Ragu Ragu
					</button>
					<button id="soal-selesai" class="btn btn-sm btn-success">
						SELESAI<span class="fa fa-check-circle"></span>
					</button>
				</div>
            </div>
        </div>
        {% block content %}

    	{% endblock %}
    </div>
	{% block modal %}
        <!--
        <div class="modal fade" id="webcam" role="dialog" aria-labelledby="webcam" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Webcam</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body d-flex align-items-center justify-content-center">
                        <div class="webcam" id="webcam-image"></div>
                    </div>
                </div>
            </div>
        </div>
        -->
    {% endblock %}

    <script>
	    var baseURL = '{{ base_url }}';
	    var uniqueID = '{{ app.key }}';
	</script>

	<script src="{{ base_url }}vendor/jquery/jquery-3.2.1.min.js"></script>
	<script src="{{ base_url }}vendor/jquery/jquery.form.min.js"></script>
    <script src="{{ base_url }}vendor/jquery/jquery.slimscroll.min.js"></script>
	<script src="{{ base_url }}vendor/bootstrap-v4/js/bootstrap.min.js"></script>
    <script src="{{ base_url }}vendor/webcam/webcam.min.js"></script>
	<script src="{{ base_url }}assets/js/custom.min.js?_dc={{ current_time }}"></script>
	{% if isReading %}
		<script src="{{ base_url }}vendor/jquery/jquery-ui.min.js"></script>
		<script src="{{ base_url }}vendor/tinymce/tinymce.min.js"></script>
		<script src="{{ base_url }}vendor/tinymce/jquery.tinymce.min.js"></script>
		<script src="{{ base_url }}assets/js/framework.min.js?_dc={{ current_time }}"></script>
		<script src="{{ base_url }}assets/js/reading.min.js?_dc={{ current_time }}"></script>
	{% else %}
		<script src="{{ base_url }}assets/js/exam.min.js?_dc={{ current_time }}"></script>
	{% endif %}
</body>

</html>