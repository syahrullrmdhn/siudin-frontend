{% extends "cetak.twig" %}
{% block content %}
	<style>
        body {
            background: #fff;
            padding-left: 40px;
            padding-right: 40px;
            padding-top: 40px;
        }

		td {
			padding: 5px;
            font-size: 14px;
		}

		.upper {
			text-transform: uppercase;
		}
	</style>
    <table class="kartu" width="100%">
        <tr>
            <td colspan="4">
                <table width="100%" class="kartu">
                <tr>
                    <td style="padding: 4px" valign="top"><img src="{{ system_logo }}" height="80"></td>
                    <td align="center" style="font-weight:bold; padding: 4px;" valign="top">
                        <span class="upper">Sekretariat Jenderal Kemhan RI <BR>Biro Kepegawaian </span><BR><BR>
                        <span class="upper">PANITIA UJIAN DINAS TK.I / UPKP PNS KEMHAN</span><BR>
                        <span class="upper">TA. 2022</span><BR><br><br>
                        <span class="upper">KARTU PESERTA</span><BR>
                    </td>
                    <td style="padding: 4px;" valign="top">
                        <div class="qrcode" id="qr_{{data.nopes}}" data-value="{{data.nopes}}"></div><BR>
                        <div style="text-align: center">{{data.nopes}}</div>
                    </td>
                </tr>
                </table><br><br>
            </td>
        </tr>
        <tr>
            <td rowspan="8" width="80" valign="top">
                <div style="width: 4cm; border: 1px solid #ccc; text-align: center; margin-right: 10px">
                    <img style="width: 100%" src="{% if foto %}{{ foto }}{% else %}{{ base_url }}assets/img/men.png{% endif %}">
                </div>
            </td>
            <td width="150" valign="top">Nama Peserta</td>
            <td width="1" valign="top">:</td>
            <td>{{ data.nama }}</td>
        </tr>
        <tr><td valign="top">NIP</td><td valign="top">:</td><td valign="top">{{ data.nip }}</td></tr>
        <tr><td valign="top">KOTAMA || SATKER</td><td valign="top">:</td><td valign="top">{{ data.nama_kotama }}&nbsp;||&nbsp;{{ data.nama_ou }}</td></tr>
        {# <tr><td valign="top">SATKER</td><td valign="top">:</td><td>{{ data.nama_ou }}</td></tr> #}
        <tr><td valign="top">Golongan / Pangkat</td><td valign="top">:</td><td valign="top">{{ data.pangkat }}</td></tr>
        <tr><td valign="top">Jabatan</td><td valign="top">:</td><td valign="top">{{ data.jabatan }}</td></tr>
        <tr><td valign="top">Jenis Ujian</td><td valign="top">:</td><td valign="top">{{ data.nama_kegiatan }}</td></tr>
        
        <tr><td valign="top">Nomor Peserta</td><td valign="top">:</td><td style="font-size:12px;font-weight:bold;" valign="top">{{ data.nopes }}</td></tr>
        <tr><td valign="top">Username</td><td valign="top">:</td><td style="font-size:12px;font-weight:bold;" valign="top">{{ data.username }}</td></tr>
        {# <tr><td valign="top">Password</td><td valign="top">:</td><td style="font-size:12px;font-weight:bold;"><input type="password" name="password" value="{{ data.password }}" readonly></td></tr> #}
        {# <tr><td valign="top">Tanggal Lahir</td><td valign="top">:</td><td>{{ data.tgl_lahir }}</td></tr> #}
        {# <tr><td valign="top">Jenis Kelamin</td><td valign="top">:</td><td>{{ data.gender }}</td></tr> #}
    </table>

	<script>
    	$('.qrcode').each(function(){
    		new QRCode(document.getElementById($(this).attr('id')), {
			    text: $(this).attr('data-value'),
			    width: 100,
			    height: 100,
			    colorDark : "#000000",
			    colorLight : "#ffffff",
			    correctLevel : QRCode.CorrectLevel.H
			});

            $(this).find('img').css({"margin":"auto"});
    	});
    </script>
{% endblock %}
