<style>
    body {
        font-family: Arial;
        font-size: 12pt;
    }

    .title td {
        border: none;
    }
</style>

<table width="100%" border="0" class="title">
    <tr><td align="center">SEKRETARIAT JENDRAL KEMHAN</td></tr>
    <tr><td align="center">BIRO KEPEGAWAIAN</td></tr>
    <tr><td align="center">&nbsp;</td></tr>
    <tr><td align="center"><b>DAFTAR NILAI</b></td></tr>
</table>
<br/><br/>
<table width="100%" class="title">
    <tr><td style="width:100px">Nama</td><td style="width:10px;">:</td><td>{{ data.nama }}</td></tr>
    <tr><td>NIP</td><td>:</td><td>{{ data.nip }}</td></tr>
    <tr><td>Pangkat/Golongan</td><td>:</td><td>{{ data.pangkat }}&nbsp;/&nbsp;{{ data.golongan }}</td></tr>
    <tr><td>Jabatan/Kesatuan</td><td>:</td><td>{{ data.jabatan }}</td></tr>
</table>
<br/><br/>
<table cellpadding="5" cellspacing="0" border="1" width="100%">
    <thead>
        <tr>
            <th align="center">NO</th>
            <th align="center">MATERI UJIAN</th>
            <th align="center">NILAI PRESENTASI</th>
            <th align="center">NILAI TERTIMBANG</th>
        </tr>
    </thead>
    <tbody>
        {% for row in tes %}
        <tr>
            <td align="center">{{ row.no }}</td>
            <td>{{ row.nama_tes }}</td>
            <td align="center">{{ row.nilai }}</td>
            <td align="center">{{ row.nilai_bobot }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
<br/><br/>
<table class="title">
    <tr>
        <td style="width: 400px"></td>
        <td align="center">
            Kepala Biro Kepegawaian<br/>
            Kabag Induk PNS<br/><br/><br/><br/><br/><br/>
            _________________________
        </td>
    </tr>
</table>
