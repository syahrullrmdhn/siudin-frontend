{% extends "cetak.twig" %}
{% block content %}
	<style>
		.page {
			padding: 1cm;
		}

		td {
			padding: 5px;
		}

		.upper {
			text-transform: uppercase;
		}
	</style>
	{% for page in data %}
    	<div class="page">
			<center>
				<table align="center" width="100%">
		        {% for line in page %}
		        	<tr>
		        	{% for row in line %}
		        		<td style="padding:3px;">
							<table style="width:10.4cm;border:1px solid #666;" class="kartu">
								<tr>
									<td colspan="4" style="border-bottom:1px solid #666; padding: 0;">
										<table width="100%" class="kartu">
										<tr>
											<td style="padding: 4px"><img src="{{ system_logo }}" height="40"></td>
											<td align="center" style="font-weight:bold; padding: 4px;">
												<span class="upper">KARTU PESERTA</span><BR>
												<span class="upper">{{ system_tes|replace({"\n": "<BR>"})|raw }}</span><BR>
											</td>
											<td style="padding: 4px; text-align: right"><div class="qrcode" id="qr_{{row.username}}" data-value="{{row.username}}" style="float: right"></div></td>
										</tr>
										</table>
									</td>
								</tr>
								<tr>
									<td rowspan="9" width="80" valign="top"><div style="width: 2cm; height: 3cm; border: 1px solid #ccc; text-align: center;">{{ row.foto | raw }}</div></td>
									<td width="100" valign="top">Nama Peserta</td>
									<td width="1" valign="top">:</td>
									<td>{{ row.nama }}</td>
								</tr>
								<tr><td valign="top">NIP</td><td valign="top">:</td><td>{{ row.nip }}</td></tr>
								<tr><td valign="top">Pangkat</td><td valign="top">:</td><td>{{ row.pangkat }}</td></tr>
								<tr><td valign="top">Jabatan</td><td valign="top">:</td><td>{{ row.jabatan }}</td></tr>
								<tr><td valign="top">Jenis Ujian</td><td valign="top">:</td><td>{{ row.nama_kegiatan }}</td></tr>
								<tr><td valign="top">Username</td><td valign="top">:</td><td style="font-size:12px;font-weight:bold;">{{ row.username }}</td></tr>
								<tr><td valign="top">Password</td><td valign="top">:</td><td style="font-size:12px;font-weight:bold;">{{ row.password }}</td></tr>
								<tr><td valign="top">Tanggal Lahir</td><td valign="top">:</td><td>{{ row.tgl_lahir }}</td></tr>
								<tr><td valign="top">Jenis Kelamin</td><td valign="top">:</td><td>{{ row.gender }}</td></tr>
							</table>
						</td>
		    		{% endfor %}
		    		</tr>
		    	{% endfor %}
	    		</table>
			</center>
		</div>
    {% endfor %}

	<script>
    	$('.qrcode').each(function(){
    		new QRCode(document.getElementById($(this).attr('id')), {
			    text: $(this).attr('data-value'),
			    width: 50,
			    height: 50,
			    colorDark : "#000000",
			    colorLight : "#ffffff",
			    correctLevel : QRCode.CorrectLevel.H
			});
    	});
    </script>
{% endblock %}
