{% extends "admin.twig" %}

{% block content %}
 <style type="text/css">
   table,th, td{
   border: 1px solid black;
   border-collapse: collapse; }
   table{ width: 100%; }
   th, td{ text-align:center; }
  </style>
    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="fa fa-book"></i>&nbsp;&nbsp;&nbsp;Rekapitulasi Peserta Ujian per Lokasi Ujian
        </div>
        <div class="panel-body">
            <div class="card">
                <div class="card-header" style="text-align: center !important">
                    <h4>Rekapitulasi Peserta Ujian per Lokasi Ujian</h4>
                </div><br>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-12 mt-4" style="font-size: 12px !important">
                            <form action="{{base_url}}user/rekapverifikasi/printlokasi" action="get">
                            <div class="form-group row">
                                <label for="inputEmail3" class="col-sm-3 mt-2">*) Pilih Kotama</label>
                                <div class="col-sm-4">
                                    <select class="form-control jabatan" name="kotama_id" id="kotama_id">
                                        <option value="">All</option>
                                            {% for key,val in ktma %}
                                                <option value="{{ val.kotama_id }}">{{ val.nama_kotama }}</option>
                                            {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="inputEmail3" class="col-sm-3 mt-2">*) Pilih Lokasi Ujian</label>
                                <div class="col-sm-4">
                                    <select class="form-control lokasi_id" name="lokasi_id">
                                        <option value="">All</option>
                                            {% for key,val in lokasi %}
                                                <option value="{{ val.lokasi_id }}">{{ val.nama_lokasi }}</option>
                                            {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="inputEmail3" class="col-sm-3 mt-2">*) Pilih Tahun</label>
                                <div class="col-sm-4">
                                <select class="form-control tahun_id" name="tahun_id">
                                        <option value="">All</option>
                                            {% for key,val in tahun %}
                                                <option value="{{ val.tahun_id }}">{{ val.tahun }}</option>
                                            {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-12" style="text-align: center !important">
                                    <button type="submit" class="btn btn-info">Show</button>
                                </div>
                            </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
           
            <br><br>
           
        </div>
    </div>
{% endblock %}
