{% extends "master.twig" %}
{% block content %}
	<div class="container">
		<div class="card card-bg" style="max-width: 700px">
			<div class="card-body">
				<h4>Status Tes</h4>
				<form id="fmToken" name="fmToken" method="POST" action="{{base_url}}peserta/exam/token" class="form-custom form-ajax">
					<div class="form-group">
						{% if tes|length > 0 %}
							{% for row in tes %}
							{% if row.tes_id == '' %}
							<div class="tes-kelompok">{{ row.kelompok }}</div>
							{% else %}
							<div class="tes-list">
								<div class="tes-list-icon"><img src="{{ base_url }}assets/img/clipboard.png"></div>
								<div>
									<div class="tes-list-nama">{{ row.nama_tes }}</div>
									<div>
										{% if row.sisa_waktu != '' %}
										<div class="tes-list-waktu"><span class="fa fa-clock"></span> Sisa waktu {{ row.sisa_waktu }}</div>
										{% endif %}
										<div class="tes-list-status">
											{% if row.status_tes == 'Sudah Selesai' %}<span class="badge badge-primary">{{ row.status_tes }}</span>{% endif %}
											{% if row.status_tes == 'Sedang Dikerjakan' %}<span class="badge badge-success">{{ row.status_tes }}</span>{% endif %}
											{% if row.status_tes == 'Akan Dikerjakan' %}<span class="badge badge-success">{{ row.status_tes }}</span>{% endif %}
											{% if row.status_tes == 'Belum Dikerjakan' %}<span class="badge badge-warning">{{ row.status_tes }}</span>{% endif %}
										</div>
									</div>
								</div>
								<div class="tes-list-soal">{{ row.jm_soal }} soal</div>
							</div>
							{% endif %}
							{% endfor %}
						{% else %}
							<div class="alert alert-warning">Tidak Ada Tes Aktif</div>
						{% endif %}
						<!---->
					</div>
					<div class="form-group">
						{% if system_selection == '1' %}
						<input type="hidden" name="tes_id" value="{{ next }}">
						{% else %}
						<label for="tes_id">Pilih Tes/Subtes</label>
						<select class="form-control" id="tes_id" name="tes_id">
							{% if tesList|length > 0 %}
								{% for row in tesList %}
									<option value="{{row.tes_id}}">{{row.nama_tes}}</option>
								{% endfor %}
							{% else %}
								<option value="">Tidak Ada Tes Aktif</option>
							{% endif %}
						</select>
						<span class="line"></span>
						{% endif %}
					</div>
					<div class="form-group">
						<label for="token">Token &nbsp;&nbsp;<strong style="font-size: 14px; color: red;"> {{ token }} </strong></label>
						<input type="text" class="form-control" id="token" name="token" placeholder="Masukan Token">
						<span class="line"></span>
					</div>
					<div class="form-group">
						<button type="button" class="btn btn-primary w-100 btn-form-ajax">Mulai</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}