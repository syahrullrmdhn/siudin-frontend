{% extends "master.twig" %}
{% block content %}
	<div class="container">
		<div class="card card-bg">
			<div class="card-body">
				<div class="row">
					<div class="col-sm-3">
						{% if (system_camera == '1' and false) %}
						<div class="rounded mb-4 text-center">
							<div class="webcam" id="webcam-image" username="{{ peserta.username }}" style="margin: auto; border-radius: 10px;overflow:hidden;"></div>
						</div>
						{% else %}
						<div class="photo"><img src="{% if foto %}{{ foto }}{% else %}{{ base_url }}assets/img/men.png{% endif %}" tes="{{foto_file}}"></div>
						{% endif %}
						<div class="photo-id">{{ peserta.nopes }}</div>
                    	<div class="photo-name">{{ peserta.nama }}</div>
						<br>
						<div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
							<a class="nav-link active" id="v-pills-home-tab" data-toggle="pill" href="#v-pills-home" role="tab" aria-controls="v-pills-home" aria-selected="true"><span class="fa fa-home"></span> Home</a>
							<a class="nav-link" id="v-pills-profile-tab" data-toggle="pill" href="#v-pills-profile" role="tab" aria-controls="v-pills-profile" aria-selected="false"><span class="fa fa-user"></span> Profile</a>
							{% if not local_server %}
							<a class="nav-link" id="v-pills-berkas-tab" data-toggle="pill" href="#v-pills-berkas" role="tab" aria-controls="v-pills-berkas" aria-selected="false"><span class="fa fa-upload"></span> Upload Berkas</a>
							<a class="nav-link" id="v-pills-lokasi-tab" data-toggle="pill" href="#v-pills-lokasi" role="tab" aria-controls="v-pills-lokasi" aria-selected="false"><span class="fa fa-home"></span> Pemilihan Lokasi Ujian</a>
							{% endif %}
							<a class="nav-link" id="v-pills-jadwal-tab" data-toggle="pill" href="#v-pills-jadwal" role="tab" aria-controls="v-pills-jadwal" aria-selected="false"><span class="fa fa-calendar"></span> Jadwal Ujian</a>
							<a class="nav-link" id="v-pills-kartu-tab" data-toggle="pill" href="#v-pills-kartu" role="tab" aria-controls="v-pills-kartu" aria-selected="false"><span class="fa fa-id-card"></span> Kartu Peserta</a>
							{% if not local_server %}
							<a class="nav-link" id="v-pills-sertifikat-tab" data-toggle="pill" href="#v-pills-sertifikat" role="tab" aria-controls="v-pills-sertifikat" aria-selected="false"><span class="fa fa-file-pdf"></span> Sertifikat</a>
							{% endif %}
						</div>
					</div>
					<div class="col-sm-9">
						<div class="tab-content" id="v-pills-tabContent">
							<div class="tab-pane fade show active" id="v-pills-home" role="tabpanel" aria-labelledby="v-pills-home-tab">
								<h6 class="mb-4"><strong><span class="fa fa-comments mr-2"></span> Selamat Datang {{ peserta.nama }}</strong></h6>
								{% if validasi.diterima %}
									{% if tes|length > 0 %}
										{% for row in tes %}
										<div class="card mt-4 card-nilai">
											<div class="card-body">
												<div class="skor">
													<div class="progress" data-percentage="{{ row.persen }}">
														<span class="progress-left">
															<span class="progress-bar"></span>
														</span>
														<span class="progress-right">
															<span class="progress-bar"></span>
														</span>
														<div class="progress-value">
															<div>
																{{ row.benar }}
															</div>
														</div>
													</div>
												</div>
												<div class="skor-keterangan">
													<span>{{ row.nama_tes }}</span>
													<small>{{ row.tanggal }}</small>
												</div>
											</div>
										</div>
										{% endfor %}
								{% else %}
									<div class="alert alert-primary">Peserta {{ peserta.nopes }} belum melaksanakan ujian, jadwal ujian bisa dilihat di menu Jadwal Ujian</div>
								{% endif %}
								{# {% elseif validasi.ditolak %}
								<div class="alert alert-danger">Mohon maaf, Peserta Ujian tidak lolos verifikasi</div> #}
								{% elseif validasi.gagalBerkas %}
								<div class="alert alert-danger">Mohon maaf, Peserta Ujian tidak lolos verifikasi Berkas</div>
								{% elseif validasi.gagalKotama %}
								<div class="alert alert-danger">Mohon maaf, Peserta Ujian tidak lolos verifikasi Kotama</div>
								{% elseif validasi.gagalSatker %}
								<div class="alert alert-danger">Mohon maaf, Peserta Ujian tidak lolos verifikasi Satker</div>
								{% elseif validasi.berkas %}
								<div class="alert alert-primary">Peserta Ujian Data Anda masih dalam tahap verifikasi Kotama dan Satker, silahkan cek secara berkala</div>
								{% elseif validasi.lulus_satker%}
								<div class="alert alert-primary">Peserta Ujian Data Anda masih dalam tahap verifikasi Satker, silahkan cek secara berkala</div>
								{% elseif validasi.kotama%}
								<div class="alert alert-primary">Peserta Ujian Data Anda masih dalam tahap verifikasi Pusat, silahkan cek secara berkala</div>
								{% elseif validasi.lulus_pusat%}
								<div class="alert alert-primary">Selamat Peserta lolos verifikasi, chek secara berkala untuk jadwal ujian</div>
								{% endif %}

							</div>
							<div class="tab-pane fade" id="v-pills-profile" role="tabpanel" aria-labelledby="v-pills-profile-tab">
								<h6 class="mb-4"><strong><span class="fa fa-user mr-2"></span> Profil Peserta</strong></h6>
								<form id="fmBio" name="fmBio" method="POST" action="{{base_url}}peserta/exam/mulai" class="form-custom form-ajax">
									<div class="form-group">
										<label for="nisn">NIP</label>
										<p class="form-control-static">{{peserta.nip}}&nbsp;</p>
									</div>
									<div class="form-group">
										<label for="nama">Nama Peserta</label>
										<p class="form-control-static">{{peserta.nama}}&nbsp;</p>
									</div>
									<div class="form-group">
										<label for="gender">Tempat Lahir</label>
										<p class="form-control-static">{{peserta.tmp_lahir}}&nbsp;</p>
									</div>
									<div class="form-group">
										<label for="lahir">Tanggal Lahir</label>
										<p class="form-control-static">{{peserta.tgl_lahir}}&nbsp;</p>
									</div>
									<div class="form-group">
