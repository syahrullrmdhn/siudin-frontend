<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">

		<title>{{ system_title }}</title>

		<link rel="icon" href="{{ system_logo }}" sizes="32x32"/>
		<link rel="stylesheet" href="{{ base_url }}vendor/bootstrap-4/css/bootstrap.min.css"/>
		<link rel="stylesheet" href="{{ base_url }}vendor/sweetalert2/sweetalert2.min.css">

		<link href="{{ base_url }}assets/css/front.min.css" rel="stylesheet"/>
	</head>
	<body>
		<div class="container-fluid">
			<div class="row min-vh-100 d-flex justify-content-center align-items-center">
				<div class="col-sm-9 py-3 mw-900">
					<div class="card">
						<div class="card-body p-0">
							<div class="row h-100 no-gutters">
								<div class="col-md-5 text-white text-center bg-card-gradient">
									<div class="position-relative p-4 pt-md-5 pb-md-7">
										<div class="bg-holder bg-auth-card-shape"></div>
										<div class="z-index-1 position-relative">
											<a class="text-white mb-4 text-sans-serif font-weight-extra-bold fs-4 d-inline-block" href="{{ base_url }}">
												<img src="{{ system_logo }}" width="80">
											</a>
											<p class="text-white text-center opacity-75">
												<span class="f-12">{{ system_organization }}</span><br>
												<span class="f-12">{{ system_office }}</span><br>
												<span class="f-10">{{ system_name|upper }}</span>
											</p>
										</div>
									</div>
									<div class="mt-3 mb-4 mt-md-4 mb-md-5">
										<p class="pt-3">Sudah Punya Akun ?<br><a class="btn btn-outline-light mt-2 px-4" href="{{ base_url }}">Login</a>
										</p>
									</div>
								</div>
								<div class="col-md-7 d-flex flex-center">
									<div class="p-3 flex-grow-1">
										<h3>Buat Akun</h3>
										<form class="needs-validation" novalidate action="{{ base_url }}api/simpeg/daftar" method="post" name="form-pendaftaran" id="form-pendaftaran">
											<div class="form-group">
												<label for="username">Username</label>
												<input class="form-control form-control-sm" type="text" id="username" name="username" required>
												<div class="invalid-feedback">Username harus diisi</div>
											</div>
											<div class="form-group">
												<label for="nama">Nama</label>
												<input class="form-control form-control-sm" type="text" id="nama" name="nama" required>
												<div class="invalid-feedback">Nama harus diisi</div>
											</div>
											<div class="form-group">
												<label for="email">Email</label>
												<input class="form-control form-control-sm" type="email" id="email" name="email" required>
												<div class="invalid-feedback">Email harus diisi</div>
											</div>
											<div class="form-group">
												<label for="telepon">Telepon</label>
												<input class="form-control form-control-sm" type="number" id="telepon" name="telepon" required>
												<div class="invalid-feedback">Telepon harus diisi</div>
											</div>
											<div class="form-row">
												<div class="form-group col-6">
													<label for="password">Password</label>
													<input class="form-control form-control-sm" type="password" id="password" name="password" required>
													<div class="invalid-feedback">Password harus diisi</div>
												</div>
												<div class="form-group col-6">
													<label for="confirm_password">Konfirmasi Password</label>
													<input class="form-control form-control-sm" type="password" id="confirm_password" name="confirm_password" required>
													<div class="invalid-feedback">Password harus diisi</div>
												</div>
											</div>
                                            <div class="form-group">
												<label for="nip">NIP</label>
												<input class="form-control form-control-sm" type="text" id="nip" name="nip" required>
												<div class="invalid-feedback">NIP harus diisi</div>
											</div>
                                            <div class="form-group">
												<label for="kegiatan_id">Jenis Ujian</label>
												<select class="custom-select d-block w-100" id="kegiatan_id" name="kegiatan_id" required></select>
                                                <div class="invalid-feedback">Kolom Jenis Ujian harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="kotama_id">UO/Kotama</label>
												<select class="custom-select d-block w-100" id="kotama_id" name="kotama_id" required></select>
                                                <div class="invalid-feedback">Kolom UO/Kotama harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="satker_id">Satker/Balakpus</label>
												<select class="custom-select d-block w-100" id="satker_id" name="satker_id" required></select>
                                                <div class="invalid-feedback">Kolom Satker/Balakpus harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="golongan_id">Golongan</label>
												<select class="custom-select d-block w-100" id="golongan_id" name="golongan_id" required></select>
                                                <div class="invalid-feedback">Kolom Golongan harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="pangkat_id">Pangkat</label>
												<select class="custom-select d-block w-100" id="pangkat_id" name="pangkat_id" required></select>
                                                <div class="invalid-feedback">Kolom Pangkat harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="jabatan_id">Jabatan</label>
												<select class="custom-select d-block w-100" id="jabatan_id" name="jabatan_id" required></select>
                                                <div class="invalid-feedback">Kolom Jabatan harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="pendidikan">Pendidikan</label>
												<select class="custom-select d-block w-100" id="pendidikan" name="pendidikan" required></select>
                                                <div class="invalid-feedback">Kolom Pendidikan harus diisi.</div>
											</div>
                                            <div class="form-group">
												<label for="universitas">Universitas</label>
												<input class="form-control form-control-sm" type="text" id="universitas" name="universitas" required>
												<div class="invalid-feedback">Universitas harus diisi</div>
											</div>
											<div class="form-group">
												<button class="btn btn-primary btn-block mt-3" type="submit" name="daftar" id="btnDaftar">Daftar</button>
											</div>
										</form>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script>
			var baseURL = '{{ base_url }}';
		</script>

		<script src="{{ base_url }}vendor/jquery/jquery-3.2.1.min.js"></script>
		<script src="{{ base_url }}vendor/jquery/jquery-migrate-1.4.1.min.js"></script>
		<script src="{{ base_url }}vendor/jquery/jquery.form.min.js"></script>
		<script src="{{ base_url }}vendor/bootstrap-4/js/bootstrap.min.js"></script>
		<script src="{{ base_url }}vendor/bootstrap-4/js/popper.min.js"></script>
		<script src="{{ base_url }}vendor/sweetalert2/sweetalert2.min.js"></script>

		<script src="{{ base_url }}assets/js/pendaftaran.min.js"></script>
	</body>
</html></body></html>
