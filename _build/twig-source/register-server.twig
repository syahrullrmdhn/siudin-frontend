<!doctype html>
<html lang="en" class="fullscreen-bg">

<head>
    <title>{{ system_title }}</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    
	<link rel="icon" href="{{ system_logo }}">
    <link rel="stylesheet" href="{{ base_url }}vendor/bootstrap-v4/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ base_url }}vendor/font-awesome-5/css/all.min.css">
    <link rel="stylesheet" href="{{ base_url }}assets/css/roboto.min.css?_dc={{ current_time }}">
    <link rel="stylesheet" href="{{ base_url }}assets/css/tinymce.css?_dc={{ current_time }}">
    <link rel="stylesheet" href="{{ base_url }}assets/css/custom.min.css?_dc={{ current_time }}">
</head>

<body>
    <div class="wrapper">
		<div class="bg"><img src="{{ base_url }}assets/img/bg.png"></div>
		<div class="container">
			<div class="header">
				<div class="logo logo-center">
					<img src="{{ system_logo }}">
					<div>
						<h2>{{ system_organization }}</h2>
						<h2>{{ system_office }}</h2>
						<h6>{{ system_name }}</h6>
					</div>
				</div>
			</div>
			<div class="card login">
				<div class="card-body">
					<h4>Registrasi ID Server</h4>
					<p>Silahkan masukkan ID server</p>
					<form id="fmRegister" name="fmRegister" method="POST" action="{{base_url}}server/register/save" class="form-ajax">
						<div class="form-group">
							<label for="server_id">ID Server</label>
							<div class="row">
								<div class="col-sm-12">
									<input type="text" class="form-control" id="server_id" name="server_id" placeholder="Masukan ID Server">
								</div>
							</div>
						</div>
						<div class="form-group">
							<label for="pin">PIN</label>
							<div class="row">
								<div class="col-sm-12">
									<input type="text" class="form-control" id="pin" name="pin" placeholder="Masukan PIN Server">
								</div>
							</div>
						</div>
						<div class="form-group">
							<label for="serial">Serial</label>
							<p class="form-control-static"><strong style="font-size: 16px">{{ serial }}</strong>&nbsp;</p>
							<input type="hidden" name="serial" value="{{ serial }}">
						</div>
						<button type="button" class="btn btn-success btn-block btn-form-ajax">SUBMIT</button>
					</form>
				</div>
				<div class="card-footer">
					
				</div>
			</div>
		</div>
    </div>

    <script>
	    var baseURL = '{{ base_url }}';
	    var uniqueID = '{{ app.key }}';
	</script>

	<script src="{{ base_url }}vendor/jquery/jquery-3.2.1.min.js"></script>
	<script src="{{ base_url }}vendor/jquery/jquery.form.min.js"></script>
	<script src="{{ base_url }}vendor/bootstrap-v4/js/bootstrap.min.js"></script>
	<script src="{{ base_url }}assets/js/custom.min.js?_dc={{ current_time }}"></script>
	{% block script %}

    {% endblock %}
</body>

</html>