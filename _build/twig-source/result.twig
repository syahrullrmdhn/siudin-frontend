<div class="card" style="max-width: 450px; margin: auto; border-radius: 10px;">
	<div class="card-body">
		<style>
			.table-xs {
				font-size: 12px;
			}
			
			.table-xs .badge {
				font-size: 11px;
				color: #fff;
			}

			.table-xs th {
				text-align: center;
				vertical-align: middle !important;
				padding: 5px;
			}

			.table-xs td {
				padding: 5px;
			}
		</style>
		<h4>Terima Kasih</h4>
		Terima Kasih sudah berpartisipasi dalam tes ini, <br>
		silahkan klik tombol LOGOUT untuk mengakhiri tes
		{% if result|length > 0 %}
		<br><br>
		<table class="table table-bordered table-striped table-xs">
			<thead>
				<tr>
					<th style="text-align: center">Nama Tes/Subtes</th>
					<th style="text-align: center">Status</th>
					{% if hasSkor %}
					<th style="text-align: center">Benar</th>
					<th style="text-align: center">Salah</th>
					{% endif %}
				</tr>
			</thead>
			<tbody>
				{% for row in result %}
				<tr>
					<td>{{ row.nama_tes }}</td>
					<td style="text-align: center">
						{% if row.status_tes == 'Sudah Selesai' %}<span class="badge badge-primary">{{ row.status_tes }}</span>{% endif %}
						{% if row.status_tes == 'Sedang Dikerjakan' %}<span class="badge badge-success">{{ row.status_tes }}</span>{% endif %}
						{% if row.status_tes == 'Akan Dikerjakan' %}<span class="badge badge-success">{{ row.status_tes }}</span>{% endif %}
						{% if row.status_tes == 'Belum Dikerjakan' %}<span class="badge badge-warning">{{ row.status_tes }}</span>{% endif %}
					</td>
					{% if row.show_skor == '1' %}
					<td style="text-align: center"><strong>{{ row.benar }}</strong></td>
					<td style="text-align: center"><strong>{{ row.salah }}</strong></td>
					{% endif %}
				</tr>
				{% endfor %}
			</tbody>
		</table>
		{% endif %}<br>
		{% if hasBelum %}
			<div class="alert alert-danger">Masih ada tes yang belum selesai, silahkan LOGOUT kemudian LOGIN kembali sesuai jadwal untuk mengerjakan tes berikutnya</div><br>
		{% endif %}
		<button type="button" id="btnLogoutTes" class="btn btn-success w-100 rounded-pill mt-3">LOGOUT</button>
	</div>
</div>